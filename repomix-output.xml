# ========== ЭНДПОИНТЫ ДЛЯ СОТРУДНИКОВ ==========

@app.get("/api/employees", response_model=List[schemas.Employee])
def get_employees(skip: int = 0, limit: int = 100, db: Session = Depends(database.get_db)):
