                          <span className="w-1.5 h-1.5 bg-amber-400 rounded-full animate-bounce [animation-delay:-0.15s]"></span>
                          <span className="w-1.5 h-1.5 bg-amber-400 rounded-full animate-bounce"></span>
                        </div>
                      </div>
                    )}
